{
    "name": "vendor/laravel-pay-kit",
    "description": "Paquete de Laravel para integración de pagos",
    "keywords": ["laravel", "payments", "payment", "pay-kit"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "paypal/paypal-server-sdk": "^2.0",
        "sermepa/sermepa": "^1.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\PayKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\PayKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\PayKit\\PayKitServiceProvider"
            ],
            "aliases": {
                "PayKit": "Vendor\\PayKit\\Facades\\PayKit"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
